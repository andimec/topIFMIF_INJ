include $(CONFIG)/RULES

# Library should be rebuilt because LIBOBJS may have changed.
$(LIBNAME): ../Makefile

# Install rules for GUI files
buildInstall : $(INSTALL_GUIS)

$(INSTALL_GUI)/%: ../%
	@echo "Installing gui $@"
	@$(INSTALL) -d -m 644 $< $(INSTALL_GUI)

# Install rules for CSS/BOY files
buildInstall : $(INSTALL_CSSS)

$(INSTALL_CSS)/%: ../%
	@echo "Installing css $@"
	@$(INSTALL) -d -m 644 $< $(INSTALL_CSS)

