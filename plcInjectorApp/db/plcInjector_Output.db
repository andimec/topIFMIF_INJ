# Inventory V1.2 reference subset. Original record bodies preserved.
# Not a standalone IOC; see reports/pv_selection.md.

record(bo, "LEBT:VAC01:PPOnCmd") {
  field(DESC, "Cde ON PP")
  field(DTYP, "S7plc")
  field(OUT, "@plcInjector/4 T=BYTE B=0")
  field(ONAM, "On")
  field(ZNAM, "Off")
  field(PINI, "YES")
  field(HIGH, "5")
}

