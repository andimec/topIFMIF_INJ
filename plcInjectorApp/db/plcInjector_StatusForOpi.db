record(calc, "LEBT:VAC01:PVOpenPrecond") {
  field(DESC, "VAC01 PV Open Precondition")
  field(SCAN, "1 second")
  field(CALC, "(A&B)|C")
  field(INPA, "LEBT:VAC01:TPDefStat")
  field(INPB, "LEBT:VAC01:PPOnStat")
  field(INPC, "LEBT:VAC01:AIVOpenStat")
}
record(calc, "LEBT:VAC01:SVOpenPrecond") {
  field(DESC, "VAC01 PV Open Precondition")
  field(SCAN, "1 second")
  field(CALC, "((((A&B)|D)|(E&F&G))&C)|H")
  field(INPA, "LEBT:VAC01:AIVOpenStat")
  field(INPB, "LEBT:VAC01:NIVOpenStat")
  field(INPC, "LEBT:VAC01:TPDefStat")
  field(INPD, "LEBT:VAC01:SVOpenStat")
  field(INPE, "LEBT:VAC01:PGTPDefStat")
  field(INPF, "LEBT:VAC01:SGTPDefStat")
  field(INPG, "LEBT:VAC01:PGVCDefStat")
  field(INPH, "LEBT:VAC:SVForcing")
}
record(calc, "LEBT:VAC02:PVOpenPrecond") {
  field(DESC, "VAC01 PV Open Precondition")
  field(SCAN, "1 second")
  field(CALC, "(A&B)|C")
  field(INPA, "LEBT:VAC02:TPDefStat")
  field(INPB, "LEBT:VAC02:PPOnStat")
  field(INPC, "LEBT:VAC02:AIVOpenStat")
}
record(calc, "LEBT:VAC02:SVOpenPrecond") {
  field(DESC, "VAC01 PV Open Precondition")
  field(SCAN, "1 second")
  field(CALC, "(A&B&C&D)|E")
  field(INPA, "LEBT:VAC02:PGTPDefStat")
  field(INPB, "LEBT:VAC02:SGTPDefStat")
  field(INPC, "LEBT:VAC02:PGVCDefStat")
  field(INPD, "LEBT:VAC02:TPSpeedStat")
  field(INPE, "LEBT:VAC:SVForcing")
}