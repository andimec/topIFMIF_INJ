#
# plcInjectorInclude.dbd
#
# This expandable database definition file includes all the definitions
# used or provided by the support application module plcInjector.
#
# It is installed by Makefile in <top>/dbd and can be included
# by other dbd files.
#
# It is also expanded by Makefile as file plcInjector.dbd in <top>/dbd. 
# VDCT can load plcInjector.dbd to edit the databases of the module plcInjector.
# 

# EPICS Base
include "base.dbd"

# Definitions provided by this support module
include "plcInjectorSupport.dbd"

# Add other support modules used by plcInjector
#include "<support name>.dbd"
#include "..."
include "s7plc.dbd"
