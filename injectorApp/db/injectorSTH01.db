# Inventory V1.2 reference subset. Original record bodies preserved.
# Not a standalone IOC; see reports/pv_selection.md.

record(stringin, "LEBT:STH01_PS:idn")
{
	field(SCAN, "10 second")
    field(DESC, "get IDN")
    field(DTYP, "stream")
    field(INP, "@MatsusadaPRK_proto.db getidn PS-STH01")
}

record(ao, "LEBT:STH01_PS:ISet")
{
    field(DESC, "Set Current")
    field(DTYP, "stream")
    field(OUT, "@MatsusadaPRK_proto.db setcurr PS-STH01")
    field(EGU, "A")
    field(LOPR, "0")
    field(HOPR, "150")
}

record(ao, "LEBT:STH01_PS:VSet")
{
    field(DESC, "Set Voltage")
    field(DTYP, "stream")
    field(OUT, "@MatsusadaPRK_proto.db setvolt PS-STH01")
    field(EGU, "V")
    field(LOPR, "0")
    field(HOPR, "8")
}

record(ai, "LEBT:STH01_PS:IRdbkcalc")
{
    field(DESC, "Measured Current")
    field(DTYP, "stream")
    field(INP, "@MatsusadaPRK_proto.db meascurr PS-STH01")
    field(EGU, "A")
    field(SCAN, "2 second")
}

record(ai, "LEBT:STH01_PS:VRdbkcalc")
{
    field(DESC, "Measured Voltage")
    field(DTYP, "stream")
    field(INP, "@MatsusadaPRK_proto.db measvolt PS-STH01")
    field(EGU, "V")
    field(SCAN, "2 second")
}

record(bi, "LEBT:STH01_PS:OnStat")
{
    field(DESC, "PS On/Off status")
    field(DTYP, "stream")
    field(INP, "@MatsusadaPRK_proto.db onstat PS-STH01")
    field(SCAN, "2 second")
}

record(bo, "LEBT:STH01_PS:ON")
{
    field(DESC, "PS On command")
    field(DTYP, "stream")
    field(HIGH, "1")
    field(OUT, "@MatsusadaPRK_proto.db on PS-STH01")
}

record(bo, "LEBT:STH01_PS:OFF")
{
    field(DESC, "PS Off command")
    field(DTYP, "stream")
    field(HIGH, "1")
    field(OUT, "@MatsusadaPRK_proto.db off PS-STH01")
}
