# Inventory V1.2 reference subset. Original record bodies preserved.
# Not a standalone IOC; see reports/pv_selection.md.

record(ai, LEBT:SOL02_PS:Status) {
  field(DESC, "lect status")
#  field(SCAN, "2 second")
  field(SCAN, "I/O Intr")
  field(DTYP, "asynInt32")
  field(INP, "@asyn(modbus_S2:lect_status 0)MODBUS_DATA")
}

record(ao, LEBT:SOL02_PS:ISet) {
  field(DESC, "ecriture Cde analog")
  field(DTYP, "asynFloat64")
  field(OMSL, "supervisory")
  field(DRVH, "600")
  field(DRVL, "0")
  field(HOPR, "600")
  field(LOPR, "0")
  field(PREC, "1")
  field(FLNK, "LEBT:SOL02_PS:IntCmd")
  field(OUT, "@asyn(modbus_S2:ecr_Icons 0 0)MODBUS_DATA")
}

record(ao, LEBT:SOL02_PS:Rampe) {
  field(DESC, "ecriture Cde analog")
  field(DTYP, "asynFloat64")
  field(OMSL, "supervisory")
  field(DRVH, "50")
  field(DRVL, "0")
  field(HOPR, "50")
  field(LOPR, "0")
  field(FLNK, "LEBT:SOL02_PS:IntCmd")
  field(OUT, "@asyn(modbus_S2:ecr_rampe 0 0)MODBUS_DATA")
}

record(bo, LEBT:SOL02_PS:IntCmd) {
#  field(OMSL, "closed_loop")
#  field(DOL, "1")
  field(VAL, "1")
  field(OUT, "SRC:SOL02_PS:RampeCmd.VAL PP")
}

record(bo, LEBT:SOL02_PS:RampeCmd) {
  field(DESC, "Cde rampe SOL02")
  field(DTYP, "asynUInt32Digital")
  field(ONAM, "ON")
  field(ZNAM, "OFF")
  field(HIGH, "1")
  field(OUT, "@asynMask(modbus_S2:ecr_Bit3 0 1 0)MODBUS_DATA")
}

record(bo, LEBT:SOL02_PS:PretRampe) {
  field(DESC, "Cde demande rampe S1")
  field(DTYP, "Soft Channel")
}

record(ai, LEBT:SOL02_PS:IRdbk) {
  field(DESC, "Lecture Icons SOL02 PS")
  field(SCAN, "I/O Intr")
  field(DTYP, "asynFloat64")
  field(INP, "@asyn(modbus_S2:lect_bloc1 0)MODBUS_DATA")
  field(PREC, "1")
}

record(calc, LEBT:SOL02_PS:OffStat) {
  field(CALC, "(A&B)>>1")
  field(INPA, "LEBT:SOL02_PS:Status PP")
  field(INPB, "2")
  field(SCAN, "1 second")
}

record(calc, LEBT:SOL02_PS:RdyStat) {
  field(CALC, "(A&B)>>2")
  field(INPA, "LEBT:SOL02_PS:Status PP")
  field(INPB, "4")
  field(SCAN, ".1 second")
}

record(bo, LEBT:SOL02_PS:ON) {
  field(DESC, "Command ON SOL02")
  field(DTYP, "asynUInt32Digital")
  field(OMSL, "supervisory")
  field(HIGH, "2")
  field(OUT, "@asynMask(modbus_S2:ecr_Bit0 0 1 0)MODBUS_DATA")
}

record(bo, LEBT:SOL02_PS:OFF) {
  field(DESC, "Command OFF SOL02")
  field(DTYP, "asynUInt32Digital")
  field(OMSL, "supervisory")
  field(HIGH, "2")
  field(OUT, "@asynMask(modbus_S2:ecr_Bit1 0 1 0)MODBUS_DATA")
}

record(bo, LEBT:SOL02_PS:RESET) {
  field(DESC, "Command reset SOL02")
  field(DTYP, "asynUInt32Digital")
  field(OMSL, "supervisory")
  field(HIGH, "2")
  field(OUT, "@asynMask(modbus_S2:ecr_Bit2 0 1 0)MODBUS_DATA")
}
