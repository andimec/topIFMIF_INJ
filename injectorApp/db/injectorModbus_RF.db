# Inventory V1.2 reference subset. Original record bodies preserved.
# Not a standalone IOC; see reports/pv_selection.md.

record(bo, SRC:RF_ATU:ModeXY) {
  field(DESC, "mode Cde X et Y")
  field(DTYP, "Soft Channel")
  field(ZNAM, "Auto")
  field(ONAM, "Remote")
}

record(calc, SRC:RF_ATU:CalcModeXY) {
  field(DESC, "calcul Cde mot 2")
  field(CALC, "(A|(B<<1))")
  field(INPA, "SRC:RF_ATU:ModeXY CPP NMS")
  field(INPB, "SRC:RF_ATU:ModeXY ")
  field(FLNK, "SRC:RF_ATU:WrtCtrl")
}

record(bo, SRC:RF_ATU:EnvoiMot2) {
  field(DTYP, "Soft Channel")
  field(OMSL, "supervisory")
  field(HIGH, "2")
  field(FLNK, "SRC:RF_ATU:CalcModeXY PP")
}

record(ao, SRC:RF_ATU:WrtCtrl) {
  field(DTYP, "asynInt32")
  field(OUT, "@asyn(modbus_RF1:ecr_X_Y_Manu 00)MODBUS_DATA")
  field(OMSL, "closed_loop")
  field(DOL, "SRC:RF_ATU:CalcModeXY")
  field(DRVH, "255")
  field(DRVL, "0")
  field(HOPR, "255")
  field(LOPR, "0")
}

