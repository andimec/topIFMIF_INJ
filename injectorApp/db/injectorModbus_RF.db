  field(INPA, "SRC:RF_GENE:MOCmdOn.VAL CPP NMS")
  field(INPB, "SRC:RF_GENE:CalcMot02.VAL NPP NMS")
  field(INPC, "63")
  field(FLNK, "SRC:RF_GENE:WrtOnOff")
}

