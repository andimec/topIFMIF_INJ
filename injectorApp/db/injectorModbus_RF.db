  field(DESC, "calcul Cde mot 2")
  field(DTYP, "Soft Channel")
  field(CALC, "(A<<2|B<<3|C<<4|D<<5|E<<6)")
  field(INPA, "SRC:RF_GENE:Modbus.VAL CPP NMS")
  field(INPB, "SRC:RF_GENE:CWmdOn.VAL CPP NMS")
  field(INPC, "SRC:RF_GENE:LimitPR.VAL CPP NMS")
  field(INPD, "SRC:RF_GENE:FilOnCmd.VAL CPP NMS")
  field(INPE, "SRC:RF_GENE:MOCmdOn.VAL CPP NMS")
  field(FLNK, "SRC:RF_GENE:WrtCtrl ")
}

