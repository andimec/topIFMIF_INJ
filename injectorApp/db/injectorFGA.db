# Inventory V1.2 reference subset. Original record bodies preserved.
# Not a standalone IOC; see reports/pv_selection.md.

record(ao, LEBT:FGA_PS3:Vdeb) {
  field(DESC, "FGA ramp G3 Set Vdeb")
  field(DTYP, "Soft Channel")
  field(OMSL, "supervisory")
  field(DRVH, "200")
  field(DRVL, "-200")
  field(HOPR, "500")
  field(LOPR, "-500")
  field(FLNK, "LEBT:FGA:CalculDV")
  field(PREC, "2")
  field(EGU, "V")
}

record(ao, LEBT:FGA_PS3:Vfin) {
  field(DESC, "FGA ramp G3 Set Vfin")
  field(DTYP, "Soft Channel")
  field(OMSL, "supervisory")
  field(DRVH, "200")
  field(DRVL, "-200")
  field(HOPR, "500")
  field(LOPR, "-500")
  field(SCAN, "Passive")
  field(FLNK, "LEBT:FGA:CalculDV")
  field(PREC, "2")
  field(EGU, "V")
}

