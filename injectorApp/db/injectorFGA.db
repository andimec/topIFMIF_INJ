record(ao, LEBT:FGA_PS3:DV) {
  field(DESC, "FGA Grid 03 Set V")
  field(DTYP, "Soft Channel")
  field(OMSL, "supervisory")
  field(DRVH, "200")
  field(DRVL, "-200")
  field(HOPR, "200")
  field(LOPR, "-200")
  field(SCAN, "Passive")
  field(DOL, "LEBT:FGA:CalculDV.VAL")
}

record(calc, LEBT:FGA:CalculDV) {
  field(DESC, "calc DV")
  field(CALC, "(B-A)/C")
  field(INPA, "LEBT:FGA_PS3:Vdeb")
  field(INPB, "LEBT:FGA_PS3:Vfin")
  field(INPC, "LEBT:FGA_PS3:Npas")
  field(FLNK, "LEBT:FGA_PS3:DV")
}

record(bo, LEBT:FGA:StopMes) {
  field(DESC, "start Measure")
  field(DTYP, "Soft Channel")
  field(HIGH, "2")
}

record(bo, LEBT:FGA:StartMes) {
  field(DESC, "start Measure")
  field(DTYP, "Soft Channel")
  field(HIGH, "2")
}

record(stringin, LEBT:FGA:Dialog) {
  field(DESC, "dialogue")
  field(DTYP, "Soft Channel")
