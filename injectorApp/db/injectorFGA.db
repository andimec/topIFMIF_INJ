record(ao, LEBT:FGA_PS3:Npas) {
  field(DESC, "FGA ramp G3 Set Npas")
  field(DTYP, "Soft Channel")
  field(OMSL, "supervisory")
  field(DRVH, "100")
  field(DRVL, "0")
  field(HOPR, "100")
  field(LOPR, "0")
  field(SCAN, "Passive")
  field(FLNK, "LEBT:FGA:CalculDV")
