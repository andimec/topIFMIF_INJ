record(stringin, "LEBT:STH02_PS:idn")
{
	field(SCAN, "10 second")
    field(DESC, "get IDN")
    field(DTYP, "stream")
    field(INP, "@MatsusadaPRK_proto.db getidn PS-STH02")
}

record(ao, "LEBT:STH02_PS:ISet")
{
    field(DESC, "Set Current")
    field(DTYP, "stream")
    field(OUT, "@MatsusadaPRK_proto.db setcurr PS-STH02")
    field(EGU, "A")
    field(LOPR, "0")
    field(HOPR, "150")
}

record(ao, "LEBT:STH02_PS:VSet")
{
    field(DESC, "Set Voltage")
    field(DTYP, "stream")
    field(OUT, "@MatsusadaPRK_proto.db setvolt PS-STH02")
    field(EGU, "V")
    field(LOPR, "0")
    field(HOPR, "8")
}

record(ai, "LEBT:STH02_PS:IRdbkcalc")
{
    field(DESC, "Measured Current")
    field(DTYP, "stream")
    field(INP, "@MatsusadaPRK_proto.db meascurr PS-STH02")
    field(EGU, "A")
    field(SCAN, "2 second")
}

record(ai, "LEBT:STH02_PS:VRdbkcalc")
{
    field(DESC, "Measured Voltage")
    field(DTYP, "stream")
    field(INP, "@MatsusadaPRK_proto.db measvolt PS-STH02")
    field(EGU, "V")
    field(SCAN, "2 second")
}

record(bi, "LEBT:STH02_PS:OnStat")
{
    field(DESC, "PS On/Off status")
    field(DTYP, "stream")
    field(INP, "@MatsusadaPRK_proto.db onstat PS-STH02")
    field(SCAN, "2 second")
}

record(bo, "LEBT:STH02_PS:ON")
{
    field(DESC, "PS On command")
    field(DTYP, "stream")
    field(HIGH, "1")
    field(OUT, "@MatsusadaPRK_proto.db on PS-STH02")
}

record(bo, "LEBT:STH02_PS:OFF")
{
    field(DESC, "PS Off command")
    field(DTYP, "stream")
    field(HIGH, "1")
    field(OUT, "@MatsusadaPRK_proto.db off PS-STH02")
}


