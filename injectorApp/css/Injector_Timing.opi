    <scripts>
      <path pathString="EmbeddedPy" checkConnect="true" sfe="false" seoe="false">
        <scriptName>Check the status of chopper</scriptName>
        <scriptText><![CDATA[from org.csstudio.opibuilder.scriptUtil import PVUtil
from org.csstudio.opibuilder.scriptUtil import ConsoleUtil

in_stat = PVUtil.getLong(pvs[0])
pulse_width = PVUtil.getDouble(pvs[1])

if in_stat == 1 and pulse_width > 3.0:
	pvs[1].setValue(3.0)
]]></scriptText>
        <pv trig="true">LEBT:CHOP:InStat</pv>
        <pv trig="true">SRC:TIM:TPulse</pv>
      </path>
    </scripts>
