    <wuid>1a6be135:13605fa7181:-6b89</wuid>
    <transparent>false</transparent>
    <scripts>
      <path pathString="EmbeddedPy" checkConnect="true" sfe="false" seoe="false">
        <scriptName>Check the statu of chopper</scriptName>
        <scriptText><![CDATA[from org.csstudio.opibuilder.scriptUtil import PVUtil
from org.csstudio.opibuilder.scriptUtil import ConsoleUtil
import math

in_stat = PVUtil.getLong(pvs[0])
pulse_width = PVUtil.getDouble(pvs[1])
rep_interval = PVUtil.getDouble(pvs[2])

# Calculate duty factor from pulse width and repetition interval
if rep_interval != 0.0:
	duty = pulse_width / rep_interval * 100
else:
	duty = 100.0

if in_stat == 1 and duty >= 5.0:
	# set the repetition rate so that the duty factor becomes more than 5%.
	pvs[2].setValue(math.floor(pulse_width + 1) * 20.0)
else:
	# Round up the repetition interval in the unit of 20 msec.
	pvs[2].setValue(math.ceil(rep_interval / 20) * 20.0)

]]></scriptText>
        <pv trig="true">LEBT:CHOP:InStat</pv>
        <pv trig="true">SRC:TIM:TPulse</pv>
        <pv trig="true">SRC:TIM:Trep</pv>
      </path>
    </scripts>
