      <path pathString="EmbeddedJs" checkConnect="true" sfe="false" seoe="false">
        <scriptName>BeamDest</scriptName>
        <scriptText><![CDATA[importPackage(Packages.org.csstudio.opibuilder.scriptUtil);


var pv0 = PVUtil.getDouble(pvs[0]);
var pv1 = PVUtil.getDouble(pvs[1]);
var pv2 = PVUtil.getDouble(pvs[2]);
var pv3 = PVUtil.getDouble(pvs[3]);
var pv4 = PVUtil.getDouble(pvs[4]);
var pv5 = PVUtil.getDouble(pvs[5]);
var pv6 = PVUtil.getDouble(pvs[6]);
var pv7 = PVUtil.getDouble(pvs[7]);

var res	=	-1;
var textval = "0";


if (pv0 == 1 && pv1 == 1 && pv2 == 1 && pv3 == 1 && pv4 == 1 && pv5 == 1 && pv6 == 1 && pv7 == 1) {
	widget.setPropertyValue("text","All Mask");
	widget.setPropertyValue("background_color","Major");
} else if (pv0 == 0 && pv1 == 1 && pv2 == 1 && pv3 == 1 && pv4 == 1 && pv5 == 1 && pv6 == 1 && pv7 == 1) {
	widget.setPropertyValue("text","FC");
	widget.setPropertyValue("background_color","Minor");
} else if (pv0 == 0 && pv1 == 0 && pv2 == 0 && pv3 == 0 && pv4 == 0) {
	widget.setPropertyValue("text","BD");
	widget.setPropertyValue("background_color","panelArea");
} else {
	widget.setPropertyValue("text","MASK");
	widget.setPropertyValue("background_color","Minor");
}]]></scriptText>
