#
# injectorInclude.dbd
#
# This expandable database definition file includes all the definitions
# used or provided by the support application module injector.
#
# It is installed by Makefile in <top>/dbd and can be included
# by dbd files.
#
# It is also expanded by Makefile as file injector.dbd in <top>/dbd. 
# VDCT can load injector.dbd to edit the databases of the module injector.
# 

# EPICS Base
include "base.dbd"

# Definitions provided by this support module
include "injectorSupport.dbd"

# Add other support modules used by injector
#include "<support name>.dbd"
#include "..."
include "aSubRecord.dbd"
include "modbus.dbd"
include "asyn.dbd"
include "stream.dbd"
include "drvAsynSerialPort.dbd"
include "drvAsynIPPort.dbd"
#include "devAdas.dbd"
#include "s7plc.dbd"
