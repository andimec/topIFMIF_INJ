#
# emitInclude.dbd
#
# This expandable database definition file includes all the definitions
# used or provided by the support application module emit.
#
# It is installed by Makefile in <top>/dbd and can be included
# by other dbd files.
#
# It is also expanded by Makefile as file emit.dbd in <top>/dbd. 
# VDCT can load emit.dbd to edit the databases of the module emit.
# 

# EPICS Base
include "base.dbd"

# Definitions provided by this support module
include "emitSupport.dbd"

# Add other support modules used by emit
#include "<support name>.dbd"
#include "..."
include "devAdas.dbd"
include "asyn.dbd"
include "motorSupport.dbd"
include "devOms.dbd"
include "devSoftMotor.dbd"
include "drvAsynSerialPort.dbd"
include "drvAsynIPPort.dbd"
include "stream.dbd"
