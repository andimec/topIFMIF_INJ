#
# Icv108Include.dbd
#
# This expandable database definition file includes all the definitions
# used or provided by the support application module Icv108.
#
# It is installed by Makefile in <top>/dbd and can be included
# by dbd files.
#
# It is also expanded by Makefile as file Icv108.dbd in <top>/dbd. 
# VDCT can load Icv108.dbd to edit the databases of the module Icv108.
# 

# EPICS Base
include "base.dbd"

# Definitions provided by this support module
include "Icv108Support.dbd"

# Add other support modules used by Icv108
#include "<support name>.dbd"
#include "SymbSupport.dbd"
include "devAdas.dbd"
